<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#6c63ff">

<title>LinguaScript — World Writing Academy</title>

<style>
:root{
 --bg:#f4f6ff;
 --surface:#ffffff;
 --surface2:#f8f9ff;
 --text:#171b2e;
 --muted:#707990;
 --border:rgba(20,30,70,.10);
 --primary:#6c63ff;
 --primary2:#918aff;
 --cyan:#00bfa6;
 --pink:#ff6584;
 --gold:#ffb020;
 --danger:#ef476f;
 --shadow:0 18px 50px rgba(39,48,100,.12);
 --radius:22px;
}

body.dark{
 --bg:#0a0e1c;
 --surface:#141a2b;
 --surface2:#101625;
 --text:#f6f7ff;
 --muted:#9ba5bc;
 --border:rgba(255,255,255,.08);
 --shadow:0 18px 50px rgba(0,0,0,.35);
}

*{
 box-sizing:border-box;
 margin:0;
 padding:0;
}

html{
 scroll-behavior:smooth;
}

body{
 font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
 background:
 radial-gradient(circle at 5% 5%,rgba(108,99,255,.13),transparent 25%),
 radial-gradient(circle at 95% 10%,rgba(0,191,166,.10),transparent 25%),
 var(--bg);
 color:var(--text);
 min-height:100vh;
 transition:.35s;
 overflow-x:hidden;
}

button,input{
 font:inherit;
}

button{
 cursor:pointer;
}

.hidden{
 display:none!important;
}

/* ---------- BACKGROUND ---------- */

#particles{
 position:fixed;
 inset:0;
 pointer-events:none;
 z-index:-1;
 overflow:hidden;
}

.particle{
 position:absolute;
 width:4px;
 height:4px;
 border-radius:50%;
 background:var(--primary);
 opacity:.16;
 animation:float 15s linear infinite;
}

@keyframes float{
 from{transform:translateY(105vh)}
 to{transform:translateY(-10vh)}
}

/* ---------- NAV ---------- */

.nav{
 position:sticky;
 top:0;
 z-index:100;
 backdrop-filter:blur(18px);
 background:color-mix(in srgb,var(--surface) 82%,transparent);
 border-bottom:1px solid var(--border);
}

.nav-inner{
 max-width:1300px;
 margin:auto;
 padding:14px 20px;
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
}

.logo{
 font-size:23px;
 font-weight:950;
 letter-spacing:-1px;
}

.logo span{
 color:var(--primary);
}

.nav-right{
 display:flex;
 align-items:center;
 gap:8px;
}

.icon{
 width:42px;
 height:42px;
 border-radius:13px;
 border:1px solid var(--border);
 background:var(--surface);
 color:var(--text);
 transition:.25s;
}

.icon:hover{
 transform:translateY(-3px);
 box-shadow:var(--shadow);
}

.profile-pill{
 padding:8px 13px;
 border:1px solid var(--border);
 border-radius:14px;
 background:var(--surface);
 color:var(--text);
 font-weight:800;
}

/* ---------- HERO ---------- */

.hero{
 max-width:1300px;
 margin:auto;
 padding:75px 20px 45px;
 display:grid;
 grid-template-columns:1.15fr .85fr;
 gap:50px;
 align-items:center;
}

.badge{
 display:inline-flex;
 padding:8px 14px;
 border-radius:50px;
 background:rgba(108,99,255,.12);
 color:var(--primary);
 font-weight:900;
 font-size:12px;
 margin-bottom:18px;
}

.hero h1{
 font-size:clamp(43px,6vw,78px);
 line-height:.98;
 letter-spacing:-4px;
 max-width:850px;
}

.gradient{
 background:linear-gradient(100deg,var(--primary),var(--cyan),var(--pink));
 background-size:200%;
 -webkit-background-clip:text;
 color:transparent;
 animation:gradient 5s infinite;
}

@keyframes gradient{
 50%{background-position:100%}
}

.hero p{
 color:var(--muted);
 font-size:18px;
 line-height:1.7;
 max-width:700px;
 margin-top:23px;
}

.actions{
 display:flex;
 gap:10px;
 flex-wrap:wrap;
 margin-top:28px;
}

.btn{
 border:none;
 border-radius:14px;
 padding:13px 18px;
 font-weight:900;
 transition:.25s;
}

.btn:hover{
 transform:translateY(-3px);
}

.primary{
 background:linear-gradient(135deg,var(--primary),var(--primary2));
 color:white;
 box-shadow:0 10px 28px rgba(108,99,255,.25);
}

.secondary{
 background:var(--surface);
 color:var(--text);
 border:1px solid var(--border);
}

.danger{
 background:rgba(239,71,111,.12);
 color:var(--danger);
}

/* ---------- ORBIT ---------- */

.hero-art{
 height:350px;
 display:grid;
 place-items:center;
 position:relative;
}

.orbit{
 width:290px;
 height:290px;
 border:1px dashed rgba(108,99,255,.4);
 border-radius:50%;
 animation:spin 20s linear infinite;
 position:relative;
}

@keyframes spin{
 to{transform:rotate(360deg)}
}

.orbit span{
 position:absolute;
 font-size:42px;
 font-weight:900;
 animation:reverseSpin 20s linear infinite;
}

@keyframes reverseSpin{
 to{transform:rotate(-360deg)}
}

.o1{top:-20px;left:115px}
.o2{right:-18px;top:110px}
.o3{bottom:-20px;left:115px}
.o4{left:-20px;top:110px}

.center{
 position:absolute;
 width:130px;
 height:130px;
 border-radius:38px;
 display:grid;
 place-items:center;
 background:var(--surface);
 box-shadow:var(--shadow);
 font-size:62px;
 animation:pulse 3s ease-in-out infinite;
}

@keyframes pulse{
 50%{transform:scale(1.08)}
}

/* ---------- MAIN ---------- */

.container{
 max-width:1300px;
 margin:auto;
 padding:15px 20px 80px;
}

.section{
 margin-top:35px;
}

.section-title{
 margin-bottom:20px;
}

.section-title h2{
 font-size:32px;
 letter-spacing:-1px;
}

.section-title p{
 color:var(--muted);
 margin-top:6px;
}

/* ---------- STATS ---------- */

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:15px;
}

.stat{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:20px;
 padding:20px;
 box-shadow:var(--shadow);
}

.stat-icon{
 font-size:28px;
}

.stat-number{
 font-size:30px;
 font-weight:950;
 margin-top:8px;
}

.stat-label{
 color:var(--muted);
}

/* ---------- LANGUAGES ---------- */

.languages{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:17px;
}

.lang-card{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:24px;
 padding:23px;
 box-shadow:var(--shadow);
 cursor:pointer;
 position:relative;
 overflow:hidden;
 transition:.3s;
}

.lang-card:hover{
 transform:translateY(-8px);
}

.lang-card:after{
 content:"";
 width:150px;
 height:150px;
 border-radius:50%;
 background:rgba(108,99,255,.08);
 position:absolute;
 right:-70px;
 bottom:-70px;
}

.lang-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.flag{
 font-size:38px;
}

.lang-card h3{
 font-size:23px;
 margin-top:17px;
}

.native{
 color:var(--muted);
 margin:5px 0 16px;
}

.bar{
 height:8px;
 border-radius:20px;
 background:rgba(100,110,140,.14);
 overflow:hidden;
}

.fill{
 height:100%;
 background:linear-gradient(90deg,var(--primary),var(--cyan));
 transition:1s;
}

.percent{
 display:flex;
 justify-content:space-between;
 color:var(--muted);
 font-size:12px;
 margin-top:7px;
}

/* ---------- APP ---------- */

.app{
 margin-top:30px;
 display:none;
 animation:up .45s ease;
}

.app.active{
 display:block;
}

@keyframes up{
 from{opacity:0;transform:translateY(20px)}
 to{opacity:1;transform:none}
}

.lesson-top{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:24px;
 padding:23px;
 box-shadow:var(--shadow);
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
}

.lesson-top h2{
 font-size:32px;
}

.lesson-top p{
 color:var(--muted);
 margin-top:5px;
}

.mode-tabs{
 display:flex;
 gap:7px;
 flex-wrap:wrap;
 margin-top:18px;
}

.mode{
 padding:11px 14px;
 border:1px solid var(--border);
 background:var(--surface);
 color:var(--text);
 border-radius:12px;
 font-weight:850;
}

.mode.active{
 background:var(--primary);
 color:white;
 border-color:var(--primary);
}

/* ---------- TOOLBAR ---------- */

.toolbar{
 margin-top:18px;
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:20px;
 padding:15px;
 display:flex;
 gap:10px;
 flex-wrap:wrap;
}

.search{
 flex:1;
 min-width:210px;
 padding:12px 14px;
 border:1px solid var(--border);
 background:var(--surface2);
 color:var(--text);
 border-radius:12px;
 outline:none;
}

.group-tabs{
 display:flex;
 gap:7px;
 flex-wrap:wrap;
}

.group{
 padding:10px 13px;
 border:1px solid var(--border);
 border-radius:11px;
 background:var(--surface2);
 color:var(--text);
 font-weight:750;
}

.group.active{
 background:var(--primary);
 color:white;
}

/* ---------- CHARACTERS ---------- */

.character-grid{
 margin-top:18px;
 display:grid;
 grid-template-columns:repeat(auto-fill,minmax(100px,1fr));
 gap:12px;
}

.character{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:17px;
 padding:14px 8px;
 text-align:center;
 position:relative;
 transition:.25s;
 cursor:pointer;
}

.character:hover{
 transform:translateY(-5px);
 border-color:var(--primary);
}

.character.learned:after{
 content:"✓";
 position:absolute;
 top:5px;
 right:8px;
 color:var(--cyan);
 font-weight:950;
}

.symbol{
 font-size:40px;
 font-weight:800;
}

.meaning{
 color:var(--muted);
 font-size:11px;
 margin-top:5px;
}

/* ---------- LEARN PANEL ---------- */

.learn-panel{
 margin-top:18px;
 display:grid;
 grid-template-columns:.75fr 1.25fr;
 gap:18px;
}

.panel{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:24px;
 padding:23px;
 box-shadow:var(--shadow);
}

.big-char{
 font-size:145px;
 text-align:center;
 line-height:1.1;
 padding:10px;
 font-weight:900;
}

.char-info{
 text-align:center;
 color:var(--muted);
}

.card-title{
 font-size:20px;
 font-weight:900;
 margin-bottom:12px;
}

/* ---------- STROKE DEMO ---------- */

.stroke-box{
 position:relative;
 min-height:360px;
 display:grid;
 place-items:center;
 overflow:hidden;
}

.stroke-grid{
 position:absolute;
 inset:25px;
 background-image:
 linear-gradient(rgba(108,99,255,.08) 1px,transparent 1px),
 linear-gradient(90deg,rgba(108,99,255,.08) 1px,transparent 1px);
 background-size:50% 50%;
 border:1px dashed var(--border);
 border-radius:18px;
}

.stroke-character{
 font-size:180px;
 position:relative;
 z-index:2;
 opacity:.12;
}

.stroke-line{
 position:absolute;
 height:5px;
 border-radius:10px;
 background:var(--primary);
 z-index:3;
 transform-origin:left center;
 animation:strokeDraw 1s ease forwards;
}

@keyframes strokeDraw{
 from{width:0;opacity:0}
 to{opacity:1}
}

.stroke-controls{
 display:flex;
 gap:8px;
 margin-top:13px;
}

/* ---------- PRACTICE ---------- */

.practice-layout{
 margin-top:18px;
 display:grid;
 grid-template-columns:.7fr 1.3fr;
 gap:18px;
}

.practice-card,
.canvas-card{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:24px;
 padding:23px;
 box-shadow:var(--shadow);
}

.practice-symbol{
 text-align:center;
 font-size:125px;
 font-weight:900;
 padding:20px;
}

.canvas-wrap{
 position:relative;
}

canvas{
 display:block;
 width:100%;
 height:370px;
 border:2px dashed var(--border);
 border-radius:18px;
 background:var(--surface2);
 touch-action:none;
 cursor:crosshair;
}

.canvas-tools{
 display:flex;
 gap:9px;
 margin-top:12px;
}

/* ---------- QUIZ ---------- */

.quiz{
 margin-top:18px;
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:24px;
 padding:28px;
 box-shadow:var(--shadow);
}

.quiz-character{
 font-size:120px;
 text-align:center;
 margin:10px;
}

.quiz-question{
 text-align:center;
 font-size:20px;
 font-weight:850;
}

.quiz-options{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:12px;
 margin-top:20px;
}

.option{
 padding:16px;
 border:1px solid var(--border);
 background:var(--surface2);
 color:var(--text);
 border-radius:14px;
 font-weight:800;
 transition:.25s;
}

.option:hover{
 transform:translateY(-3px);
 border-color:var(--primary);
}

.option.correct{
 background:rgba(0,191,166,.15);
 border-color:var(--cyan);
}

.option.wrong{
 background:rgba(239,71,111,.15);
 border-color:var(--danger);
}

/* ---------- VOCAB ---------- */

.vocab-grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:13px;
 margin-top:15px;
}

.vocab{
 background:var(--surface2);
 border:1px solid var(--border);
 padding:17px;
 border-radius:16px;
}

.vocab-word{
 font-size:28px;
 font-weight:900;
}

.vocab-translation{
 color:var(--muted);
 margin-top:5px;
}

/* ---------- ACHIEVEMENTS ---------- */

.achievements{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:13px;
}

.achievement{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:18px;
 padding:18px;
 opacity:.42;
 transition:.3s;
}

.achievement.unlocked{
 opacity:1;
 box-shadow:var(--shadow);
}

.achievement-icon{
 font-size:32px;
}

.achievement h4{
 margin-top:8px;
}

.achievement p{
 color:var(--muted);
 font-size:12px;
 margin-top:4px;
}

/* ---------- PROFILE ---------- */

.profile{
 margin-top:18px;
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:18px;
}

.profile-card{
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:23px;
 padding:22px;
 box-shadow:var(--shadow);
}

.profile input{
 width:100%;
 margin:8px 0;
 padding:12px;
 border:1px solid var(--border);
 border-radius:12px;
 background:var(--surface2);
 color:var(--text);
}

/* ---------- REVIEW ---------- */

.review-list{
 display:grid;
 gap:10px;
 margin-top:15px;
}

.review-item{
 background:var(--surface2);
 border:1px solid var(--border);
 border-radius:15px;
 padding:15px;
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
}

/* ---------- MODAL ---------- */

.modal{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.55);
 backdrop-filter:blur(8px);
 display:none;
 place-items:center;
 z-index:500;
 padding:20px;
}

.modal.active{
 display:grid;
}

.modal-card{
 width:min(500px,100%);
 background:var(--surface);
 border:1px solid var(--border);
 border-radius:25px;
 padding:28px;
 box-shadow:var(--shadow);
 animation:modalIn .3s ease;
}

@keyframes modalIn{
 from{transform:scale(.9);opacity:0}
 to{transform:scale(1);opacity:1}
}

/* ---------- TOAST ---------- */

.toast{
 position:fixed;
 bottom:25px;
 left:50%;
 transform:translate(-50%,100px);
 opacity:0;
 background:#111827;
 color:white;
 padding:13px 20px;
 border-radius:14px;
 z-index:1000;
 transition:.4s;
}

.toast.show{
 transform:translate(-50%,0);
 opacity:1;
}

/* ---------- FOOTER ---------- */

footer{
 padding:45px 20px;
 text-align:center;
 color:var(--muted);
}

footer strong{
 color:var(--primary);
}

/* ---------- MOBILE ---------- */

@media(max-width:950px){

 .hero{
  grid-template-columns:1fr;
 }

 .hero-art{
  display:none;
 }

 .languages{
  grid-template-columns:repeat(2,1fr);
 }

 .stats{
  grid-template-columns:repeat(2,1fr);
 }

 .learn-panel,
 .practice-layout,
 .profile{
  grid-template-columns:1fr;
 }

 .achievements{
  grid-template-columns:repeat(2,1fr);
 }

 .vocab-grid{
  grid-template-columns:1fr 1fr;
 }

}

@media(max-width:600px){

 .hero{
  padding-top:45px;
 }

 .hero h1{
  font-size:45px;
  letter-spacing:-2px;
 }

 .languages{
  grid-template-columns:1fr;
 }

 .stats{
  grid-template-columns:1fr 1fr;
 }

 .lesson-top{
  align-items:flex-start;
  flex-direction:column;
 }

 .character-grid{
  grid-template-columns:repeat(4,1fr);
 }

 .symbol{
  font-size:30px;
 }

 .quiz-options{
  grid-template-columns:1fr;
 }

 .vocab-grid{
  grid-template-columns:1fr;
 }

 .achievements{
  grid-template-columns:1fr 1fr;
 }

}
</style>
</head>

<body>

<div id="particles"></div>

<!-- =====================================================
 NAVIGATION
===================================================== -->

<nav class="nav">

<div class="nav-inner">

<div class="logo">
 Lingua<span>Script</span> ✍️
</div>

<div class="nav-right">

<button class="profile-pill"
onclick="openProfile()">
 👤 <span id="profileName">Learner</span>
</button>

<button class="icon"
id="themeButton">
 🌙
</button>

</div>

</div>

</nav>


<!-- =====================================================
 HERO
===================================================== -->

<section class="hero">

<div>

<div class="badge">
 🌍 WORLD WRITING ACADEMY
</div>

<h1>
 Learn to
 <span class="gradient">
 write
 </span>
 the world's languages.
</h1>

<p>
 Master writing systems through interactive character
 lessons, stroke demonstrations, handwriting practice,
 pronunciation, quizzes, vocabulary and spaced review.
</p>

<div class="actions">

<button class="btn primary"
onclick="scrollToLanguages()">
 Start Learning →
</button>

<button class="btn secondary"
onclick="openProfile()">
 My Learning Profile
</button>

</div>

</div>


<div class="hero-art">

<div class="orbit">

<span class="o1">한</span>
<span class="o2">文</span>
<span class="o3">あ</span>
<span class="o4">ع</span>

</div>

<div class="center">
 ✍️
</div>

</div>

</section>


<!-- =====================================================
 MAIN
===================================================== -->

<main class="container">


<section class="section">

<div class="section-title">

<h2>
 Your progress
</h2>

<p>
 Every practice session contributes to your learning journey.
</p>

</div>


<div class="stats">

<div class="stat">
<div class="stat-icon">🔥</div>
<div class="stat-number" id="streakStat">0</div>
<div class="stat-label">Day streak</div>
</div>

<div class="stat">
<div class="stat-icon">⭐</div>
<div class="stat-number" id="xpStat">0</div>
<div class="stat-label">XP</div>
</div>

<div class="stat">
<div class="stat-icon">✍️</div>
<div class="stat-number" id="learnedStat">0</div>
<div class="stat-label">Characters learned</div>
</div>

<div class="stat">
<div class="stat-icon">🏆</div>
<div class="stat-number" id="levelStat">1</div>
<div class="stat-label">Level</div>
</div>

</div>

</section>


<!-- =====================================================
 LANGUAGES
===================================================== -->

<section class="section"
id="languageSection">

<div class="section-title">

<h2>
 Choose your writing system
</h2>

<p>
 Six writing systems. One learning platform.
</p>

</div>

<div class="languages"
id="languages">
</div>

</section>


<!-- =====================================================
 LEARNING APPLICATION
===================================================== -->

<section class="app"
id="learningApp">

<div class="lesson-top">

<div>

<h2 id="lessonTitle">
 Language
</h2>

<p id="lessonDescription">
 Choose a character to begin.
</p>

</div>

<button class="btn danger"
onclick="closeLesson()">
 ✕ Close
</button>

</div>


<div class="mode-tabs">

<button class="mode active"
onclick="setMode('learn',this)">
 📚 Learn
</button>

<button class="mode"
onclick="setMode('practice',this)">
 ✍️ Practice
</button>

<button class="mode"
onclick="setMode('quiz',this)">
 🧠 Quiz
</button>

<button class="mode"
onclick="setMode('review',this)">
 🔁 Review
</button>

<button class="mode"
onclick="setMode('vocabulary',this)">
 📖 Vocabulary
</button>

<button class="mode"
onclick="printWorksheet()">
 🖨️ Worksheet
</button>

</div>


<!-- ================= LEARN ================= -->

<div id="learnMode">

<div class="toolbar">

<input
class="search"
id="characterSearch"
placeholder="Search character, sound or meaning..."
oninput="renderCharacters()">

<div
class="group-tabs"
id="groupTabs">
</div>

</div>


<div
class="character-grid"
id="characterGrid">
</div>


<div class="learn-panel">

<div class="panel">

<div class="card-title">
 Selected character
</div>

<div
class="big-char"
id="bigCharacter">
?
</div>

<div
class="char-info"
id="characterInfo">
Select a character above.
</div>

<div class="actions">

<button class="btn primary"
onclick="speakSelected()">
 🔊 Pronounce
</button>

<button class="btn secondary"
onclick="markLearned()">
 ✓ Learned
</button>

