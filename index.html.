========================================================= */

function speak(text){

 if(!("speechSynthesis" in window))
  return;

 speechSynthesis.cancel();

 const map={
  korean:"ko-KR",
  chinese:"zh-CN",
  japanese:"ja-JP",
  arabic:"ar-SA",
  russian:"ru-RU",
  english:"en-US"
 };

 const u=
  new SpeechSynthesisUtterance(text);

 u.lang=map[currentLanguage];

 u.rate=.7;

 speechSynthesis.speak(u);

}


function speakSelected(){

 if(currentCharacter)
  speak(currentCharacter);

}


/* =========================================================
