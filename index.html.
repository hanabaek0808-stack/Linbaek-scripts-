function escapeSpeak(text){

 return text.replace(/'/g,"\\'");

}


/* =========================================================
 KOREAN SYLLABLE BUILDER
========================================================= */

function buildKoreanSyllable(){

 if(currentLanguage!=="korean"){

  showModal(
   "Korean syllable builder",
   "Open the Korean lesson to use Korean syllable construction."
  );

  return;

 }

 const consonants=
  ["ㄱ","ㄴ","ㄷ","ㄹ","ㅁ","ㅂ","ㅅ","ㅇ","ㅈ","ㅎ"];

 const vowels=
  ["ㅏ","ㅑ","ㅓ","ㅕ","ㅗ","ㅜ","ㅡ","ㅣ"];

 const c=
  prompt(
   "Choose consonant:\n"+
   consonants.join(" ")
  );

 const v=
  prompt(
   "Choose vowel:\n"+
   vowels.join(" ")
  );

 const map={
  "ㄱ":0,"ㄴ":2,"ㄷ":3,"ㄹ":5,"ㅁ":6,
  "ㅂ":7,"ㅅ":9,"ㅇ":11,"ㅈ":12,"ㅎ":18
 };

 const vowel={
  "ㅏ":0,"ㅑ":2,"ㅓ":4,"ㅕ":6,
  "ㅗ":8,"ㅜ":13,"ㅡ":18,"ㅣ":20
 };

 if(
  c &&
  v &&
  map[c]!==undefined &&
  vowel[v]!==undefined
 ){

  const code=
   0xAC00+
   map[c]*21*28+
   vowel[v]*28;

  const syllable=
   String.fromCharCode(code);

  showModal(
   "Korean syllable builder",
   `${c} + ${v} → ${syllable}<br><br>`+
   "This demonstrates how Hangul combines letters into syllable blocks."
  );

 }

}


