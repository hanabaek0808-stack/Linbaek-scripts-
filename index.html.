  .textContent=
  `What does "${target[0]}" represent?`;

 let options=[target[1]];

 while(options.length<4){

  const random=
   chars[Math.floor(
    Math.random()*chars.length
   )][1];

  if(!options.includes(random))
   options.push(random);

 }

 options.sort(()=>Math.random()-.5);

 const root=
  document.getElementById("quizOptions");

 root.innerHTML="";

 options.forEach(option=>{

  const b=document.createElement("button");

  b.className="option";

  b.textContent=option;

  b.onclick=()=>answerQuiz(
   b,
   option,
   target[1]
  );

  root.appendChild(b);

 });

}


function answerQuiz(button,answer,correct){

 document.querySelectorAll(".option")
  .forEach(b=>b.disabled=true);

 if(answer===correct){

  button.classList.add("correct");

  state.quizScore++;
  state.xp+=15;

  toast("Correct! +15 XP 🎉");

 }else{

  button.classList.add("wrong");

  document.querySelectorAll(".option")
   .forEach(b=>{
    if(b.textContent===correct)
     b.classList.add("correct");
   });

  toast("Not quite — review this character.");

 }

 state.quizTotal++;

 document.getElementById("quizScore")
  .textContent=
  `Score: ${state.quizScore}/${state.quizTotal}`;

 save();
 updateStats();

 setTimeout(createQuiz,1200);

}


/* =========================================================
 REVIEW
========================================================= */

function renderReview(){

 const root=document.getElementById("reviewList");

 root.innerHTML="";

 const now=Date.now();

 const entries=Object.entries(state.learned)
  .filter(([k,v])=>v.next<=now);

 if(!entries.length){

  root.innerHTML=`
   <div style="color:var(--muted);padding:20px">
    🎉 No characters are due for review.
   </div>
  `;

  return;

 }

 entries.slice(0,20).forEach(([k])=>{

  const [lang,char]=k.split("|");

  const data=
   allChars(DATA[lang])
    .find(c=>c[0]===char);

  if(!data)return;

  const row=document.createElement("div");

  row.className="review-item";

  row.innerHTML=`
   <div>
    <strong style="font-size:30px">${char}</strong>
    <span style="color:var(--muted)">
     ${data[1]}
    </span>
   </div>

   <button class="btn primary">
    Review
   </button>
  `;

  row.querySelector("button")
   .onclick=()=>{

    currentLanguage=lang;
    currentGroup=
     Object.keys(DATA[lang].groups)
      .find(g=>
       DATA[lang].groups[g]
        .some(c=>c[0]===char)
      );

    openLesson(lang);

    setMode("practice",
     document.querySelectorAll(".mode")[1]
    );

    selectCharacter(data);

   };

  root.appendChild(row);

 });

}


/* =========================================================
 SPACED REPETITION
========================================================= */

function scheduleNextReview(k){

 if(!state.learned[k])return;

 const current=
  state.learned[k];

 const old=current.interval||1;

 const interval=
  Math.min(old*2,30);

 state.learned[k]={
  ...current,
  interval,
  next:Date.now()+
   interval*86400000
 };

 save();

}


