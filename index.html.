/* =========================================================
 PARTICLES
========================================================= */

function createParticles(){

 const root=document.getElementById("particles");

 for(let i=0;i<35;i++){

  const p=document.createElement("div");

  p.className="particle";

  p.style.left=Math.random()*100+"%";

  p.style.animationDuration=
   (8+Math.random()*15)+"s";

  p.style.animationDelay=
   (-Math.random()*15)+"s";

  root.appendChild(p);

 }

}


/* =========================================================
 SAVE
========================================================= */

function save(){

 localStorage.setItem(
  "linguaScriptState",
  JSON.stringify(state)
 );

}


/* =========================================================
 STREAK
========================================================= */

function initializeStreak(){

 const today=new Date()
  .toISOString()
  .split("T")[0];

 if(state.lastVisit!==today){

  if(state.lastVisit){

   const old=new Date(state.lastVisit);
   const now=new Date(today);

   const diff=Math.round(
    (now-old)/(1000*60*60*24)
   );

   if(diff===1)
    state.streak++;

   else if(diff>1)
    state.streak=1;

  }else{
   state.streak=1;
  }

  state.lastVisit=today;

  save();

 }

}


/* =========================================================
 LANGUAGES
========================================================= */

function allChars(lang){

 return Object.values(lang.groups).flat();

}


function learnedFor(language){

 return Object.keys(state.learned)
  .filter(k=>k.startsWith(language+"|"));

}


function key(language,char){

 return language+"|"+char;

}


function renderLanguages(){

 const root=document.getElementById("languages");

 root.innerHTML="";

 Object.entries(DATA).forEach(([id,lang])=>{

  const total=allChars(lang).length;

  const learned=learnedFor(id).length;

  const percent=total?
   Math.round(learned/total*100):0;

  const card=document.createElement("div");

  card.className="lang-card";

  card.onclick=()=>openLesson(id);

  card.innerHTML=`

   <div class="lang-head">
    <div class="flag">${lang.flag}</div>
    <strong>${percent===100?"✓ COMPLETE":"BEGINNER"}</strong>
   </div>

   <h3>${lang.name}</h3>

   <div class="native">
    ${lang.native} · ${lang.system}
   </div>

   <div class="bar">
    <div class="fill"
     style="width:${percent}%"></div>
   </div>

   <div class="percent">
    <span>${learned}/${total} learned</span>
    <strong>${percent}%</strong>
   </div>

  `;

  root.appendChild(card);

 });

}


/* =========================================================
 OPEN LESSON
========================================================= */

function openLesson(id){

 currentLanguage=id;

 const lang=DATA[id];

 currentGroup=Object.keys(lang.groups)[0];

 document.getElementById("lessonTitle").textContent=
  `${lang.flag} ${lang.name}`;

 document.getElementById("lessonDescription").textContent=
  lang.description;

 document.getElementById("learningApp")
  .classList.add("active");

 renderGroupTabs();

 renderCharacters();

 renderVocabulary();

 document.getElementById("learningApp")
  .scrollIntoView({behavior:"smooth"});

}


function closeLesson(){

 document.getElementById("learningApp")
  .classList.remove("active");

}


/* =========================================================
