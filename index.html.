  "The demonstration is a general practice guide. " +
  "For production use, connect official per-character " +
  "stroke-order data for exact stroke validation."
 );

}


/* =========================================================
 PRACTICE CANVAS
========================================================= */

function setupCanvas(){

 canvas=document.getElementById("canvas");

 ctx=canvas.getContext("2d");

 resizeCanvas();

 window.addEventListener("resize",resizeCanvas);

 canvas.addEventListener(
  "pointerdown",
  e=>{
   drawing=true;

   const p=position(e);

   ctx.beginPath();
   ctx.moveTo(p.x,p.y);
  }
 );

 canvas.addEventListener(
  "pointermove",
  e=>{

   if(!drawing)return;

   const p=position(e);

   ctx.lineTo(p.x,p.y);
   ctx.stroke();

  }
 );

 ["pointerup","pointerleave"]
 .forEach(event=>
  canvas.addEventListener(
   event,
   ()=>drawing=false
  )
 );

}


function resizeCanvas(){

 if(!canvas)return;

 const rect=canvas.getBoundingClientRect();

 canvas.width=
  rect.width*devicePixelRatio;

 canvas.height=
  rect.height*devicePixelRatio;

 ctx.scale(
  devicePixelRatio,
  devicePixelRatio
 );

 ctx.lineWidth=5;
 ctx.lineCap="round";
 ctx.lineJoin="round";

}


function position(e){

 const r=canvas.getBoundingClientRect();

 return{
  x:e.clientX-r.left,
  y:e.clientY-r.top
 };

}


function clearCanvas(){

 if(!canvas)return;

 ctx.clearRect(
  0,
  0,
  canvas.width,
  canvas.height
 );

}


function completeWriting(){

 if(!currentCharacter){

  toast("Select a character first.");

  return;

 }

 markLearned();

 state.xp+=5;

 save();

 toast("Writing practice completed! +5 XP ✍️");

}


