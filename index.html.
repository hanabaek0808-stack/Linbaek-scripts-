========================================================= */

function markLearned(){

 if(!currentCharacter){

  toast("Select a character first.");

  return;

 }

 const k=key(
  currentLanguage,
  currentCharacter
 );

 if(!state.learned[k]){

  state.learned[k]={
   date:Date.now(),
   next:Date.now()+86400000
  };

  state.xp+=10;

  toast("Character learned! +10 XP 🎉");

 }else{

  toast("Already learned ✓");

 }

 save();

 updateStats();
 renderLanguages();
 renderCharacters();
 renderAchievements();

}


