========================================================= */

function animateStrokes(){

 const root=document.getElementById("strokeLines");

 root.innerHTML="";

 /*
  Generic educational stroke visualization.
  Real stroke datasets can later be connected here.
 */

 const patterns=[
  [35,80,220,80],
  [125,35,125,250],
  [55,130,195,130],
  [75,190,180,190]
 ];

 patterns.forEach((p,i)=>{

  const line=document.createElement("div");

  line.className="stroke-line";

  line.style.left=p[0]+"px";
  line.style.top=p[1]+"px";
  line.style.transform=
   `rotate(${Math.atan2(
    p[3]-p[1],
    p[2]-p[0]
   )}rad)`;

  line.style.animationDelay=
   (i*.5)+"s";

  root.appendChild(line);

 });

}


function showStrokeGuide(){

 showModal(
  "Stroke-order guide",
