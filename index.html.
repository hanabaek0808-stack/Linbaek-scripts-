========================================================= */

function renderGroupTabs(){

 const root=document.getElementById("groupTabs");

 root.innerHTML="";

 Object.keys(DATA[currentLanguage].groups)
  .forEach(group=>{

   const b=document.createElement("button");

   b.className="group"+
    (group===currentGroup?" active":"");

   b.textContent=group;

   b.onclick=()=>{

    currentGroup=group;

    renderGroupTabs();
    renderCharacters();

   };

   root.appendChild(b);

  });

}


/* =========================================================
